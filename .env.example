# PinTrip environment variables
# Copy this file to `.env.local` and fill in the values, then restart `npm run dev`.

# Mapbox public access token — used for geocoding and map rendering.
# Create one (free tier is plenty for the MVP) at:
#   https://account.mapbox.com/access-tokens/
# A "Default public token" works. It is exposed to the browser by design
# (hence the NEXT_PUBLIC_ prefix), so scope it to URL-restricted usage in prod.
NEXT_PUBLIC_MAPBOX_TOKEN=
